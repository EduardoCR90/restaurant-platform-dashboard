# Secretos personalizados: ningún nombre debe empezar por SUPABASE_.
# Supabase inyecta SUPABASE_URL, SUPABASE_PUBLISHABLE_KEYS/SUPABASE_SECRET_KEYS
# y, en entornos heredados, SUPABASE_ANON_KEY/SUPABASE_SERVICE_ROLE_KEY.
# Opcional: clave pública explícita, si necesitas seleccionar una clave concreta
# o si tu runtime no proporciona un default automático. Nunca usar secret/service_role.
# APP_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Origen exacto; separados por coma si necesitas varios. No comodines.
ALLOWED_ORIGINS=http://localhost:5173
# JSON privado: claves por integration.id (UUID), valores token write de ese proyecto.
SANITY_TOKENS={}
# Aprovisionamiento (solo backend). Token personal/de organización con permisos para
# crear proyectos en la organización indicada. No usar un token editorial de restaurante.
SANITY_PROVISIONER_TOKEN=replace-in-supabase-secrets
SANITY_PROVISIONING_ORGANIZATION_ID=replace-with-organization-id
# ID de usuario Sanity esperado; Edge comprueba identidad y rol Administrator.
SANITY_EXPECTED_ADMIN_USER_ID=replace-with-sanity-user-id
# AES-256-GCM: mapa de claves base64url (32 bytes) y versión activa.
# Conservar versiones antiguas mientras existan credenciales cifradas con ellas.
APP_INTEGRATION_CREDENTIAL_ACTIVE_KEY=v1
APP_INTEGRATION_CREDENTIAL_KEYS={"v1":"replace-with-32-byte-base64url-key"}
# Aprovisionamiento Astro/GitHub (solo backend). La credencial necesita crear
# repositorios desde el template, ejecutar workflows y administrar GitHub Pages.
GITHUB_PROVISIONER_TOKEN=replace-in-supabase-secrets
GITHUB_REPOSITORY_OWNER=replace-with-github-owner
GITHUB_TEMPLATE_REPOSITORY=replace-with-owner/restaurant-astro-template
GITHUB_TEMPLATE_REPOSITORY_ID=replace-with-numeric-repository-id
GITHUB_INSTANCE_BOOTSTRAP_WORKFLOW=bootstrap-instance.yml
GITHUB_INSTANCE_VISIBILITY=private
# Invitación final del alta integral; HTTPS y ruta de cambio de contraseña:
INVITE_REDIRECT_URL=https://dashboard.example/auth/update-password
# Opcional: excepción exacta de Salitre, solo en secretos backend. No es un booleano global.
# SALITRE_PRODUCTION_WRITE_TARGET={"restaurantId":"UUID_REAL","integrationId":"UUID_EXISTENTE","projectId":"hfa8zkyw","dataset":"production"}
# Sin configuración válida, production sigue bloqueado; staging permanece operativo.

# El seguimiento de Astro usa OIDC GitHub: no necesita PAT ni secreto de callback.
# La clave administrativa automática solo registra metadatos tras autorización.
